{
  "combined": "jvm-build-tools",
  "integration": false,
  "libpak-tools": {
    "command": "build-jvm-build-tools",
    "artifact-flag": "tools",
    "include-all-flag": "include-all-tools"
  },
  "buildpacks": [
    { "name": "jvm-build-tools", "image": "jvm-build-tools" },
    { "name": "leiningen", "image": "leiningen-dev" },
    { "name": "clojure-tools", "image": "clojure-tools-dev" },
    { "name": "gradle", "image": "gradle-dev" },
    { "name": "maven", "image": "maven-dev" },
    { "name": "sbt", "image": "sbt-dev" }
  ]
}
